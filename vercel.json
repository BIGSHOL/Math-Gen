{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ai-:action",
      "destination": "/api/ai?route=ai-:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 120
    },
    "api/figure-render.py": {
      "maxDuration": 30,
      "includeFiles": "{vendor/figure-engine/**,scripts/figure/**}",
      "excludeFiles": "{node_modules/**,.checks.local/**}"
    }
  }
}
